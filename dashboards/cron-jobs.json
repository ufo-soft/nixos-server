{
  "__inputs": [],
  "__requires": [],
  "uid": "cron-jobs",
  "title": "Cron Jobs",
  "tags": ["cron", "systemd", "healthchecks"],
  "editable": true,
  "refresh": "1m",
  "schemaVersion": 38,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "title": "",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Healthchecks — All Checks",
      "description": "Live status of all registered Healthchecks checks via API",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "healthchecks" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://healthchecks:8000/api/v3/checks/",
          "root_selector": "checks",
          "columns": [
            { "selector": "name", "text": "Check", "type": "string" },
            { "selector": "status", "text": "Status", "type": "string" },
            { "selector": "last_ping", "text": "Last Ping", "type": "timestamp" },
            { "selector": "next_ping", "text": "Next Ping", "type": "timestamp" },
            { "selector": "last_duration", "text": "Duration (s)", "type": "number" },
            { "selector": "n_pings", "text": "Total Pings", "type": "number" }
          ],
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "up": { "text": "UP", "color": "green" } } },
                  { "type": "value", "options": { "down": { "text": "DOWN", "color": "red" } } },
                  { "type": "value", "options": { "grace": { "text": "GRACE", "color": "yellow" } } },
                  { "type": "value", "options": { "new": { "text": "NEW", "color": "blue" } } },
                  { "type": "value", "options": { "paused": { "text": "PAUSED", "color": "purple" } } }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background" }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Checks Down",
      "description": "Number of Healthchecks checks currently in down state",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 11 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "healthchecks" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://healthchecks:8000/api/v3/checks/",
          "root_selector": "checks",
          "columns": [
            { "selector": "status", "text": "status", "type": "string" }
          ],
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "filters": [
              {
                "fieldName": "status",
                "config": {
                  "id": "equal",
                  "options": { "value": "down" }
                }
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": { "reducer": "count" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Checks in Grace Period",
      "description": "Checks that are late but still within their grace period",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 11 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "healthchecks" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://healthchecks:8000/api/v3/checks/",
          "root_selector": "checks",
          "columns": [
            { "selector": "status", "text": "status", "type": "string" }
          ],
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "filters": [
              {
                "fieldName": "status",
                "config": {
                  "id": "equal",
                  "options": { "value": "grace" }
                }
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": { "reducer": "count" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "title": "Systemd — Job Status",
      "description": "Current state of each cron job service",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "node_systemd_unit_state{name=~\"cron-.*\\\\.service\"}",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["name", "state", "Value"]
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "filters": [
              {
                "fieldName": "Value",
                "config": {
                  "id": "greater",
                  "options": { "value": 0 }
                }
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [{ "id": "displayName", "value": "Job" }]
          },
          {
            "matcher": { "id": "byName", "options": "state" },
            "properties": [
              { "id": "displayName", "value": "State" },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "inactive": { "text": "OK (inactive)", "color": "green" } } },
                  { "type": "value", "options": { "active": { "text": "Running", "color": "blue" } } },
                  { "type": "value", "options": { "failed": { "text": "FAILED", "color": "red" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "Systemd — Last Trigger Time",
      "description": "How long ago each cron timer last fired",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "time() - node_systemd_timer_last_trigger_seconds{name=~\"cron-.*\\\\.timer\"}",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["name", "Value"]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [{ "id": "displayName", "value": "Timer" }]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "displayName", "value": "Time Since Last Run" }]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Systemd — Failed Jobs",
      "description": "Cron services currently in failed state",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(node_systemd_unit_state{name=~\"cron-.*\\\\.service\", state=\"failed\"} == 1) or vector(0)",
          "legendFormat": "Failed Jobs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Systemd — Job State Over Time",
      "description": "Track which jobs have been in failed state over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "node_systemd_unit_state{name=~\"cron-.*\\\\.service\", state=\"failed\"}",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Systemd — Timer Triggers",
      "description": "When each timer fired",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "changes(node_systemd_timer_last_trigger_seconds{name=~\"cron-.*\\\\.timer\"}[5m])",
          "legendFormat": "{{ name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    }
  ]
}
